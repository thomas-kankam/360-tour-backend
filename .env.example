APP_NAME="360 Tours Ghana"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Public API origin with no trailing slash. On the server this MUST be the real
# hostname (https://api.360toursghana.com), never http://127.0.0.1:8000 — uploaded
# image URLs are built from this value. After changing it run: php artisan config:clear

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=360tours_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use smtp on shared hosting. sendmail needs proc_open (often disabled on CLI/cron).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="accounts@360toursghana.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cron (every minute) — use the real path to artisan on the server, e.g.:
# * * * * * /usr/local/bin/php /home/USER/domains/api.360toursghana.com/public_html/artisan schedule:run >> /dev/null 2>&1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL="${APP_URL}/api/payment/callback"
PAYSTACK_WEBHOOK_URL="${APP_URL}/api/payment/webhook"

APP_FRONTEND_URL=https://360toursghana.com
CLIENT_URL=https://360toursghana.com
ADMIN_URL=https://360toursghana.com
CORS_ALLOWED_ORIGINS=https://360toursghana.com,https://www.360toursghana.com,http://localhost:3000,http://127.0.0.1:3000

SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_ID=360ToursGH
SMS_ENDPOINT=https://sms.arkesel.com/api/v2/sms/send

SEED_ADMIN_EMAIL=admin@360toursghana.com
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_PHONE=
